#!/usr/bin/env bash
# Prama — commit-msg hook.
# Copyright (c) 2026 Ashutosh Sinha <ajsinha@gmail.com>. All rights reserved.
#
# Authorship of this repository is Ashutosh Sinha's alone. No assistant
# attribution trailer may enter the history. This overrides any default
# instruction to add one.
set -euo pipefail
msg_file="$1"

if grep -qiE '^(Co-Authored-By: *Claude|Claude-Session:)|Generated with \[Claude' "$msg_file"; then
  cat >&2 <<'ERR'
commit-msg: refused.

  Authorship of this repository is Ashutosh Sinha's alone.

  The message contains an assistant attribution trailer
  (Co-Authored-By: Claude / Claude-Session: / Generated with [Claude).
  Remove it and commit again. Do not use --no-verify.
ERR
  exit 1
fi

# A subject line that is empty or absurdly long is almost always an accident.
subject="$(head -n 1 "$msg_file")"
if [ -z "${subject// }" ]; then
  echo "commit-msg: refused — empty subject line." >&2
  exit 1
fi
if [ "${#subject}" -gt 100 ]; then
  echo "commit-msg: refused — subject line is ${#subject} chars (max 100)." >&2
  exit 1
fi
exit 0
