#!/usr/bin/env bash
# Prama — pre-commit hook.
# Copyright (c) 2026 Ashutosh Sinha <ajsinha@gmail.com>. All rights reserved.
set -euo pipefail

staged() { git diff --cached --name-only --diff-filter=ACM; }

# The venv's tools, found from the tree being committed and then from the main
# checkout, so a worktree or a shell without the venv activated still lints
# (after Maya's hook). A hook that silently skips lint because `ruff` was not
# on PATH is a hook that passes everything.
top="$(git rev-parse --show-toplevel)"
main="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
bin=""
for candidate in "$top/.venv/bin" "$main/.venv/bin"; do
  if [ -x "$candidate/python" ]; then bin="$candidate"; break; fi
done
py="python3"; ruff_cmd="ruff"
if [ -n "$bin" ]; then py="$bin/python"; ruff_cmd="$bin/ruff"; fi

# 1. Source-file length ceiling (1500 code lines, comments excluded).
files=$(staged | grep -E '\.(py|rs|sql|sh)$' || true)
if [ -n "$files" ]; then
  # shellcheck disable=SC2086
  "$py" scripts/check_file_length.py $files
fi

# 2. Secrets never enter a tracked config file. application.local.* is ignored
#    and is where a real secret belongs.
tracked_cfg=$(staged | grep -E '^config/.*\.(yaml|yml|properties|json)$' | grep -v '\.local\.' || true)
if [ -n "$tracked_cfg" ]; then
  if grep -nEi '(secret|password|passwd|token|api[_-]?key|private[_-]?key)[[:space:]]*[:=][[:space:]]*[^[:space:]"'"'"']+' $tracked_cfg \
     | grep -vEi '(:[[:space:]]*(""|''|~|null)[[:space:]]*$)|\$\{' ; then
    echo "pre-commit: refused — a non-empty secret appears in a TRACKED config file." >&2
    echo "  Put it in config/application.local.yaml (git-ignored), or use \${VAR:default}." >&2
    exit 1
  fi
fi

# 3. The version is stated once (src/prama/version.py); every copy agrees.
"$py" scripts/check_version_source.py

# 4. Lint + format, if the toolchain is present.
if command -v "$ruff_cmd" >/dev/null 2>&1; then
  # qa/harness is deliberately not linted (it is the QA team's scratch
  # harness, as in CI's `ruff check src sdk kernel agent tests qa/regression-suite`).
  pyfiles=$(staged | grep -E '\.py$' | grep -v '^qa/harness/' || true)
  if [ -n "$pyfiles" ]; then
    # shellcheck disable=SC2086
    # Two statements, not `a && b`: under `set -e` a failure on the left of
    # `&&` does not stop the script, so lint errors were printed and the
    # commit went ahead anyway (found 2026-09-27, when it let one through).
    "$ruff_cmd" check $pyfiles
    "$ruff_cmd" format --check $pyfiles
  fi
fi
exit 0
